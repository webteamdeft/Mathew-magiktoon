# Local database/file backups. These contain Session rows with live Shopify
# access tokens, so they must never reach a remote.
backups/

# Database exports. Order rows carry customer names, addresses and email
# addresses in `requestPayload.shippingAddress`, and this repository is
# public. Keep exports outside the repo; pass their path to
# scripts/restore-from-export.mjs instead.
magiktoon-*export*.json
*-export-[0-9]*.json

