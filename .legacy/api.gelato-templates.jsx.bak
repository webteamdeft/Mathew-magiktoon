import { authenticate } from "../shopify.server";
import { listGelatoTemplates } from "../lib/gelato.server";

function asArray(value) {
  if (Array.isArray(value)) return value;

  if (value && typeof value === "object") {
    if (Array.isArray(value.items)) return value.items;
    if (Array.isArray(value.products)) return value.products;
    if (Array.isArray(value.data)) return value.data;
    if (Array.isArray(value.nodes)) return value.nodes;
  }

  return [];
}

export async function loader({ request }) {
  await authenticate.admin(request);

  try {
    const result = await listGelatoTemplates({
      offset: 0,
      limit: 100,
    });

    const templates = asArray(result?.items);

    return Response.json({
      ok: true,
      source: result?.source || "store-products",
      templates,
    });
  } catch (error) {
    console.error("Gelato templates error:", error);

    return Response.json(
      {
        ok: false,
        error:
          error.message ||
          "Gelato templates could not be loaded.",
        source: "error",
        templates: [],
      },
      { status: 502 }
    );
  }
}
